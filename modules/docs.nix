# Dokumentacja referencyjna generowana z flake'a: docs/reference/hosts.md
# (hosty z rejestru, moduły każdego hosta, diagram), modules.md (katalog
# wszystkich modułów z opisem z nagłówka) i options.md (opcje rejestru
# hostów, customTop, customBot i ai). Opis modułu to pierwszy akapit komentarza
# na początku pliku.
#
# Generator czyta tylko źródła modułów (readFile + wyrażenia regularne na
# flake.modules.nixos.<nazwa> i self.modules.nixos.<nazwa>), dane rejestru
# i deklaracje opcji — nigdy konfiguracji hostów, więc jest tani także na
# RPi i działa w hooku pre-commit. Asercja pilnuje, żeby znalezione eksporty
# były dokładnie flake.modules.nixos (nic nie ginie po cichu).
#
# Odświeżanie: hook sync-docs albo `nix run .#sync-docs` (nieaktualne
# docs/reference oblewa CI lint).
{
  config,
  lib,
  options,
  ...
}:
let
  root = ./.;
  rel = file: "modules" + lib.removePrefix (toString root) (toString file);

  # Te same pliki co import-tree we flake.nix: każdy .nix bez segmentu `_`.
  files = lib.filter (file: lib.hasSuffix ".nix" (toString file) && !lib.hasInfix "/_" (rel file)) (
    lib.filesystem.listFilesRecursive root
  );

  takeWhile =
    pred: list: lib.take (lib.lists.findFirstIndex (x: !pred x) (lib.length list) list) list;
  matches =
    regex: text: map builtins.head (builtins.filter builtins.isList (builtins.split regex text));

  # Pierwszy akapit wiodącego komentarza pliku, jako jedna linia.
  summary =
    text:
    let
      comment = takeWhile (lib.hasPrefix "#") (lib.splitString "\n" text);
      paragraph = takeWhile (line: line != "") (map (line: lib.trim (lib.removePrefix "#" line)) comment);
    in
    lib.concatStringsSep " " paragraph;

  sources = map (
    file:
    let
      text = builtins.readFile file;
    in
    {
      path = rel file;
      summary = summary text;
      exports = matches "flake\\.modules\\.nixos\\.([A-Za-z0-9_-]+)[[:space:]]*=" text;
      refs = lib.unique (matches "self\\.modules\\.nixos\\.([A-Za-z0-9_-]+)" text);
    }
  ) files;

  exported = lib.sort lib.lessThan (lib.concatMap (source: source.exports) sources);
  declared = lib.attrNames config.flake.modules.nixos;
  checkedSources =
    lib.throwIfNot (exported == declared)
      "docs.nix: eksporty znalezione w modules/ (${toString exported}) różnią się od flake.modules.nixos (${toString declared})"
      sources;

  sourceOf = lib.listToAttrs (
    lib.concatMap (source: map (name: lib.nameValuePair name source) source.exports) checkedSources
  );
  module = name: sourceOf.${name} or (throw "docs.nix: self.modules.nixos.${name} nie istnieje");

  hostSource =
    name:
    lib.findFirst (
      source: source.path == "modules/hosts/${name}/default.nix"
    ) (throw "docs.nix: host ${name} nie ma modules/hosts/${name}/default.nix") checkedSources;
  # Moduły hosta: odwołania z jego default.nix i, rekurencyjnie, z plików
  # modułów, do których się odwołuje.
  closure =
    name:
    lib.sort lib.lessThan (
      map (entry: entry.key) (
        builtins.genericClosure {
          startSet = map (key: { inherit key; }) (hostSource name).refs;
          operator = { key }: map (ref: { key = ref; }) (module key).refs;
        }
      )
    );
  hostNames = lib.attrNames config.hosts;
  hostsOf = name: lib.filter (host: lib.elem name (closure host)) hostNames;

  banner = "<!-- Generated by modules/docs.nix (`nix run .#sync-docs`, pre-commit hook sync-docs). Do not edit. -->\n\n";
  code = text: "`${text}`";
  # Link z docs/reference/ do pliku w repo.
  link = path: "[${lib.removePrefix "modules/" path}](../../${path})";
  # `<nazwa>` poza kodem GitHub bierze za znacznik HTML i go usuwa.
  escapeTags =
    text:
    lib.concatStringsSep "`" (
      lib.imap0 (i: part: if lib.mod i 2 == 0 then lib.replaceStrings [ "<" ] [ "\\<" ] part else part) (
        lib.splitString "`" text
      )
    );
  describe = text: if text == "" then "*(no header comment)*" else escapeTags text;
  # Katalog modułu względem modules/: grupa w spisie.
  group = path: lib.concatStringsSep "/" (lib.init (lib.tail (lib.splitString "/" path)));
  nodeId = lib.replaceStrings [ "-" ] [ "_" ];

  hostsPage = lib.concatStrings (
    [
      banner
      "# Hosts\n\n"
      "Declared in the host registry (`modules/hosts/registry.nix`); each host is `nixosConfigurations.<name>` and the target of its `update` aliases.\n\n"
      "| Host | Platform | CI build on `v*` tags | Modules |\n|---|---|---|---|\n"
    ]
    ++ map (
      name:
      let
        host = config.hosts.${name};
      in
      "| [${code name}](#${name}) | ${code host.system} | ${
        if host.buildOnTags then "yes" else "no (PR, manual)"
      } | ${toString (lib.length (closure name))} |\n"
    ) hostNames
    ++ map (
      name:
      let
        source = hostSource name;
        direct = source.refs;
        # Krawędzie każdego modułu hosta, który importuje inne (agregaty,
        # moduł sprzętu, base-agenix → base-secrets).
        nested = lib.filter (ref: ref != name && (module ref).refs != [ ]) (closure name);
      in
      lib.concatStrings (
        [
          "\n## ${name}\n\n"
          "${describe source.summary}\n\n"
          "```mermaid\nflowchart LR\n"
          "  host_${nodeId name}([${name}])\n"
        ]
        ++ map (ref: "  host_${nodeId name} --> ${nodeId ref}[${ref}]\n") (lib.remove name direct)
        ++ lib.unique (
          lib.concatMap (
            importer: map (ref: "  ${nodeId importer} --> ${nodeId ref}[${ref}]\n") (module importer).refs
          ) nested
        )
        ++ [ "```\n\n" ]
        ++ map (ref: "- ${code ref} — ${link (module ref).path}\n") (closure name)
      )
    ) hostNames
  );

  modulesPage = lib.concatStrings (
    [
      banner
      "# Modules\n\n"
      "Every `.nix` file under `modules/` (except paths with a `_`-prefixed segment) is a flake-parts module. Files exporting NixOS modules list them as `flake.modules.nixos.<name>`; the description is the first paragraph of the file's header comment.\n"
    ]
    ++ lib.mapAttrsToList (
      dir: grouped:
      lib.concatStrings (
        [ "\n## ${if dir == "" then "modules/" else "modules/${dir}/"}\n\n" ]
        ++ map (
          source:
          let
            hosts = lib.unique (lib.concatMap hostsOf source.exports);
          in
          lib.concatStrings [
            "- **${link source.path}**"
            (lib.optionalString (source.exports != [ ])
              " (${lib.concatMapStringsSep ", " code source.exports})"
            )
            (lib.optionalString (hosts != [ ]) " · hosts: ${lib.concatMapStringsSep ", " code hosts}")
            " — ${describe source.summary}\n"
          ]
        ) grouped
      )
    ) (lib.groupBy (source: group source.path) checkedSources)
  );

  docList =
    prefix: opts:
    lib.filter (opt: lib.hasPrefix prefix opt.name && opt.visible && !opt.internal) (
      lib.optionAttrSetToDocList opts
    );
  renderOption =
    opt:
    "### ${code opt.name}\n\n${escapeTags (lib.trim opt.description)}\n\n- Type: ${opt.type}\n"
    + lib.optionalString (opt ? default) "- Default: ${code opt.default.text}\n"
    # flake-parts dopisuje do pliku deklaracji ", via option flake.modules…".
    + "- Declared in: ${
      lib.concatMapStringsSep ", " (
        file: link (rel (lib.head (lib.splitString ", via " (toString file))))
      ) opt.declarations
    }\n\n";

  nixosOptions =
    module:
    (lib.evalModules {
      class = "nixos";
      modules = [ module ];
    }).options;

  optionsPage = lib.concatStrings (
    [
      banner
      "# Options\n\n"
      "## Host registry (flake-parts)\n\n"
    ]
    ++ map renderOption (docList "hosts." { inherit (options) hosts; })
    ++ [
      "## Repository constants (`customTop`, flake-parts and NixOS)\n\n"
      "Read-only; the values are set in [args.nix](../../modules/args.nix).\n\n"
    ]
    ++ map renderOption (docList "customTop." { inherit (options) customTop; })
    ++ [ "## Host options (`customBot`, NixOS)\n\n" ]
    ++ map renderOption (docList "customBot." (nixosOptions config.flake.modules.nixos.base-options))
    ++ [ "## Agent skills and models (`ai`, NixOS)\n\n" ]
    ++ map renderOption (docList "ai." (nixosOptions config.flake.modules.nixos.ai-options))
  );
in
{
  perSystem =
    { config, pkgs, ... }:
    {
      packages = {
        docs = pkgs.linkFarm "docs-reference" {
          "hosts.md" = pkgs.writeText "hosts.md" hostsPage;
          "modules.md" = pkgs.writeText "modules.md" modulesPage;
          "options.md" = pkgs.writeText "options.md" optionsPage;
        };

        sync-docs = pkgs.writeShellApplication {
          name = "sync-docs";
          runtimeInputs = [ pkgs.coreutils ];
          text = ''
            # docs/reference zawiera wyłącznie pliki generowane.
            mkdir -p docs/reference
            rm -f docs/reference/*.md
            cp -fL ${config.packages.docs}/*.md docs/reference/
            chmod u+w docs/reference/*.md
          '';
        };
      };
    };
}
