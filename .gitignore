# W modules/_secrets tylko zaszyfrowane .age i reguły/klucze publiczne —
# odszyfrowana wersja roboczo zapisana obok (np. `age -d x.age > x`) nie
# trafi do publicznego repo przez `git add`.
/modules/_secrets/*
!/modules/_secrets/*.age
!/modules/_secrets/agenix-rules.nix
!/modules/_secrets/keys.nix
